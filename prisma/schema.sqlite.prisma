// SQLite variant of the MERAGLYM schema, used by the self-contained desktop
// build (embedded local database). It mirrors prisma/schema.prisma model-for-
// model. Two differences are required because SQLite has no native ENUM type:
//   - the Region / SourceHealth enums are represented as String columns
//   - the generated client is emitted to a separate output directory
// Keep this file in sync with prisma/schema.prisma when models change.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
}

model Node {
  id             Int      @id @default(autoincrement())
  parentId       Int?
  parent         Node?    @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children       Node[]   @relation("NodeChildren")
  name           String
  type           String // "folder" or "url"
  url            String?
  description    String?
  status         String?
  pricing        String?
  bestFor        String?
  input          String?
  output         String?
  opsec          String?
  opsecNote      String?
  localInstall   Boolean?
  googleDork     Boolean?
  registration   Boolean?
  editUrl        Boolean?
  api            Boolean?
  invitationOnly Boolean?
  deprecated     Boolean?
  createdAt      DateTime @default(now())

  @@index([parentId])
}

model Job {
  id          Int       @id @default(autoincrement())
  type        String // e.g. "ingest_arf"
  status      String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, RETRY
  payload     Json?
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

// NOTE: Region and SourceHealth are Postgres enums in the primary schema.
// SQLite has no ENUM type, so they are stored as String here. The allowed
// values match the Postgres enum members.
model Source {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  region       String    @default("GLOBAL") // Region enum value
  description  String?
  url          String?
  healthStatus String    @default("HEALTHY") // SourceHealth enum value
  lastSuccess  DateTime?
  errorRate    Float     @default(0.0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  adapters     SourceAdapter[]
  observations Observation[]
}

model SourceAdapter {
  id         Int      @id @default(autoincrement())
  sourceId   Int
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  identifier String   @unique // e.g., "egrul_api", "email_holehe"
  version    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Entity {
  id          Int      @id @default(autoincrement())
  type        String // "Person", "Organization", "Email", "IP", "Domain", etc.
  value       String // The actual identifier: "target@example.com"
  metadata    Json? // Any additional fields specific to this entity type
  confidence  Float    @default(1.0)
  reliability Float    @default(1.0)
  aliases     Json? // JSON array of alias strings for entity resolution
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sourceRelationships Relationship[] @relation("SourceEntity")
  targetRelationships Relationship[] @relation("TargetEntity")
  observations        Observation[]
  events              Event[]

  @@unique([type, value])
  @@index([type])
}

model Relationship {
  id             Int      @id @default(autoincrement())
  sourceEntityId Int
  targetEntityId Int
  type           String // e.g., "OWNS", "RESOLVES_TO", "COMMUNICATES_WITH"
  confidence     Float    @default(1.0)
  source         Entity   @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  target         Entity   @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([sourceEntityId, targetEntityId, type])
  @@index([type])
}

model Observation {
  id           Int      @id @default(autoincrement())
  entityId     Int
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sourceId     Int?
  originSource Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  timestamp    DateTime @default(now()) // When this was observed
  payload      Json // The raw or normalized observation data
  createdAt    DateTime @default(now())
}

model Location {
  id        Int      @id @default(autoincrement())
  latitude  Float
  longitude Float
  address   String?
  city      String?
  country   String?
  createdAt DateTime @default(now())

  events Event[]
}

model Event {
  id          Int       @id @default(autoincrement())
  entityId    Int
  entity      Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  timestamp   DateTime // When the event occurred (historical)
  type        String // "Sightings", "Transactions", "Registrations"
  description String?
  createdAt   DateTime  @default(now())

  @@index([timestamp])
}
